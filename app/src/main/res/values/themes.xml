<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ana tema koyu tabanli; Compose kendi ColorScheme'ini yonetir -->
    <style name="Theme.NovaTV" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/nova_background</item>
        <item name="android:colorBackground">@color/nova_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- Oynatici: tam siyah, gizli cubuk -->
    <style name="Theme.NovaTV.Player" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
